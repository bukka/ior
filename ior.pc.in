prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: ior
Description: Cross-platform io_uring-like async I/O library
Version: @PROJECT_VERSION@
Requires.private: @IOR_PC_REQUIRES_PRIVATE@
Libs: -L${libdir} -lior
Libs.private: -lpthread
Cflags: -I${includedir}/ior
